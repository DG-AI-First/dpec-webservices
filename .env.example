# Copiar a .env y completar. NUNCA commitear .env.
#
# Sólo las dos primeras son obligatorias. Todo lo demás tiene default y está
# acá para que se vea qué se puede tocar, no porque haga falta setearlo.

# --- Obligatorias ---

# Si la contraseña tiene " # \ o espacios, va entre comillas dobles.
SAP_USER=
SAP_PASSWORD=

# --- Destino (default: QA) ---

# qa | prod — exacto, sensible a mayúsculas. Cualquier otra cosa es error
# fatal al arrancar, nunca un fallback silencioso.
DPEC_ENV=qa

# Obligatoria SÓLO con DPEC_ENV=prod, y con esta frase exacta. La fricción es
# deliberada: un `true` es lo que llega copiando el .env de un compañero.
# DPEC_CONFIRM_PROD=I_UNDERSTAND_THIS_HITS_PRODUCTION

# https | http. El PDF de DPEC dice http; no funciona.
DPEC_SCHEME=https

# Tres dígitos. OJO: se llama SAP_CLIENT, no DPEC_SAP_CLIENT.
SAP_CLIENT=100

# --- Server HTTP (npm start) ---

PORT=3000

# Plazo propio del server. DEBE ser menor que DPEC_TIMEOUT_MS: un DNI
# inexistente cuelga el RFC sin responder, y este corte es lo único que evita
# retener la conexión. loadConfig() rechaza el arranque si es mayor o igual.
DPEC_SERVER_DEADLINE_MS=15000

# Timeout de cada llamada SOAP.
DPEC_TIMEOUT_MS=30000

# --- Escapes, comentadas a propósito ---

# utf8 | latin1. Si da 401 con credenciales correctas, probar latin1: los
# stacks SAP suelen asumir ISO-8859-1.
# DPEC_BASIC_AUTH_CHARSET=utf8

# CA interna, si algún día la cadena de certificados deja de validar sola.
# DPEC_TLS_CA_FILE=./ca.pem

# Desactiva la verificación TLS. Sólo QA: config.ts la rechaza bajo
# DPEC_ENV=prod sin importar el valor. Tiene que ser esta frase exacta.
# DPEC_TLS_INSECURE=YES_I_ACCEPT_INSECURE_TLS_ON_QA
