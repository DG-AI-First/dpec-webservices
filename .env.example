# Copy to .env and fill in. NEVER commit .env.
# Credentials arrive via WhatsApp — if the password contains " # \ or spaces,
# wrap it in double quotes. If auth fails with 401 despite correct values,
# try DPEC_BASIC_AUTH_CHARSET=latin1 (SAP stacks often assume ISO-8859-1).

SAP_USER=
SAP_PASSWORD=

# qa | prod  — exact, case-sensitive. Anything else is a fatal error, never a fallback.
DPEC_ENV=qa

# Required ONLY when DPEC_ENV=prod. Must be this exact sentence.
# DPEC_CONFIRM_PROD=I_UNDERSTAND_THIS_HITS_PRODUCTION

DPEC_SCHEME=https
SAP_CLIENT=100
DPEC_TIMEOUT_MS=30000
DPEC_BASIC_AUTH_CHARSET=utf8

# --- Server HTTP (npm start) ---
PORT=3000
# Plazo propio del server. DEBE ser menor que DPEC_TIMEOUT_MS: un DNI
# inexistente cuelga el RFC sin responder, y este corte es lo unico que
# evita retener la conexion. loadConfig() lo rechaza si es mayor o igual.
DPEC_SERVER_DEADLINE_MS=15000

